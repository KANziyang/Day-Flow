{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DayFlow",
  "version": "1.0.2",
  "identifier": "com.dayflow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DayFlow",
        "width": 1120,
        "height": 760,
        "minWidth": 800,
        "minHeight": 560,
        "visible": false,
        "center": true
      },
      {
        "label": "widget",
        "title": "DayFlow 小组件",
        "url": "index.html?window=widget",
        "width": 320,
        "height": 420,
        "minWidth": 260,
        "minHeight": 300,
        "decorations": false,
        "resizable": true,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false,
        "transparent": true
      },
      {
        "label": "ball",
        "title": "DayFlow 悬浮球",
        "url": "index.html?window=ball",
        "width": 56,
        "height": 56,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"],
    "shortDescription": "轻量本地任务与工作记录",
    "category": "Productivity",
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
